{
  "name": "dokito",
  "version": "0.1.0",
  "private": true,
  "description": "Local Markdown knowledge, projects, and tasks for people and agents",
  "type": "module",
  "bin": {
    "dokito": "./src/cli/index.ts"
  },
  "scripts": {
    "build": "bun run build:web && bun build ./src/cli/index.ts --compile --jsx-runtime=automatic --outfile ./dist/dokito",
    "build:web": "bun run build:js && bun run build:css",
    "build:css": "tailwindcss -i ./src/web/styles.css -o ./src/web/styles.generated.css --minify",
    "build:js": "bun build ./src/web/client.ts --minify --target=browser --outfile ./src/web/client.generated.js",
    "check": "bun run build:web && bun run lint && bun run typecheck && bun run deadcode && bun run test",
    "deadcode": "knip",
    "format": "biome format --write .",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "test": "bun test tests",
    "test:e2e": "bun run build:web && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/cli": "^4.3.0",
    "@types/bun": "1.3.14",
    "@types/mdast": "4.0.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "knip": "^6.29.0",
    "tailwindcss": "^4.3.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "hono": "^4.12.32",
    "mdast-util-from-markdown": "^2.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "keywords": [
    "markdown",
    "context",
    "coding-agents",
    "cli",
    "local-first"
  ],
  "author": "Stefan Gasser",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sgasser/dokito"
  }
}
